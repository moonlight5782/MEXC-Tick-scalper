# MEXC browser session token. Never commit a real value.
MEXC_WEB_TOKEN=WEB_REPLACE_ME

# Live web Futures base. Keep writes disabled unless intentionally testing.
MEXC_WEB_BASE_URL=https://futures.mexc.com/api/v1
MEXC_WEB_ORIGIN=https://www.mexc.com
MEXC_WEB_REFERER=https://www.mexc.com/
MEXC_WEB_TIMEOUT_SECONDS=5

# For MEXC Demo, capture the actual Demo request base URL from DevTools Network
# and override MEXC_WEB_BASE_URL locally. Do not guess a Demo API hostname.
