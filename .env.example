# LIVE MEXC browser session token. Never commit a real value.
MEXC_WEB_TOKEN=WEB_REPLACE_ME
MEXC_WEB_BASE_URL=https://futures.mexc.com/api/v1
MEXC_WEB_ORIGIN=https://www.mexc.com
MEXC_WEB_REFERER=https://www.mexc.com/
MEXC_WEB_TIMEOUT_SECONDS=5

# Real-money browser-session order writes are OFF unless this is explicitly YES.
# Keep NO for all scan/shadow/research sessions.
MEXC_LIVE_WRITE=NO

# DEMO / TESTNET browser session. Kept separate from LIVE on purpose.
# Obtain the WEB token from an authenticated futures.testnet.mexc.com browser session.
MEXC_DEMO_WEB_TOKEN=WEB_REPLACE_ME
MEXC_DEMO_WEB_BASE_URL=https://futures.testnet.mexc.com/api/v1
MEXC_DEMO_WEB_ORIGIN=https://futures.testnet.mexc.com
MEXC_DEMO_WEB_REFERER=https://futures.testnet.mexc.com/futures/BTC_USDT
MEXC_DEMO_WEB_TIMEOUT_SECONDS=5

# Must be explicitly enabled for Demo write tests/sessions.
MEXC_DEMO_WRITE=NO
