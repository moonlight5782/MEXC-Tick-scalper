+def test_zero_fill_ioc_reconciliation_recovers_late_remote_position(monkeypatch):
+    remote = PositionSnapshot(
+        symbol="TEST_USDT",
+        side=OrderSide.LONG,
+        qty=1.0,
+        entry_price=100.0,
+        leverage=50,
+        isolated=True,
