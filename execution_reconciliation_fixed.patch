+    monkeypatch.setattr(hybrid, "IOC_RECONCILE_ZERO_FILL_SECONDS", 0.1)
+
+    adapter = FakeAdapter()
+    recovered = asyncio.run(
+        hybrid._reconcile_ioc_position(adapter, "TEST_USDT", OrderSide.LONG, fill)
